{
  "name": "tree-sitter-rsc",
  "version": "0.1.5",
  "description": "MikroTik RouterOS Script grammar for tree-sitter",
  "main": "bindings/node",
  "types": "bindings/node/index.d.ts",
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "install": "node-gyp rebuild",
    "build-wasm": "tree-sitter build-wasm",
    "playground": "tree-sitter build-wasm && tree-sitter playground"
  },
  "author": "balakar94",
  "license": "Apache-2.0",
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.26.0"
  },
  "files": [
    "grammar.js",
    "binding.gyp",
    "bindings/node/*",
    "queries/*",
    "src/**"
  ],
  "tree-sitter": [
    {
      "scope": "source.rsc",
      "file-types": [
        "rsc"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^rsc$"
    }
  ]
}
